Checks:
  - '-*'                                     # 先禁用所有检查作为基线
  - 'readability-*'                          # 启用所有 readability 类检查
  - '-readability-non-const-parameter'       # 禁用：误报，Skia 接口 const 修饰不完善
  - '-readability-uppercase-literal-suffix'  # 禁用：不强制浮点字面量后缀大写 F
  - '-readability-identifier-length'         # 禁用：不检查变量名长度（如 x、y）
  - '-readability-isolate-declaration'       # 禁用：不强制单条语句只声明一个变量
  - '-readability-magic-numbers'             # 禁用：不强制将魔法数字替换为命名常量
  - '-readability-convert-member-functions-to-static'  # 禁用：不强制将不访问成员变量的成员函数改为 static